JWT_SECRET=genera-una-stringa-lunga-e-casuale
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiami

# Porta host per il frontend (default 8080). Cambiala se sull'host di destinazione
# la 8080 e' gia' occupata da un altro servizio (es. dashboard-raspi su raspi-gorghy
# usa gia' :8080 nativamente -> li' serve HOST_PORT=8081 o altra porta libera).
HOST_PORT=8080
